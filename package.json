{
  "name": "lsr-store",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium",
    "e2e:typecheck": "tsc --project e2e/tsconfig.json",
    "preview": "node scripts/preview.mjs",
    "e2e:production": "playwright test --config=playwright.production.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "UPDATE_SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts --project=chromium"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ng-icons/bootstrap-icons": "^36.1.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/font-awesome": "^36.1.0",
    "@ng-primitives/mcp": "^0.131.3",
    "ng-primitives": "^0.131.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.6.5",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
